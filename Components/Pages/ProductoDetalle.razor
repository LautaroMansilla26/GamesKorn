@page "/producto/{Id:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AppDbContext Context
@inject CarritoState CarritoState
@inject NavigationManager Navigation
@using GamesKorn.Components.Models
@using GamesKorn.Data
@using Microsoft.EntityFrameworkCore

<PageTitle>GamesKorn - Detalle del Producto</PageTitle>

<div class="container py-4 text-white">
    <button class="btn btn-outline-light mb-4" @onclick="VolverAlCatalogo">
        <i class="bi bi-arrow-left me-2"></i> Volver al Catálogo
    </button>

    @if (producto == null)
    {
        <div class="d-flex align-items-center gap-2" style="color: #00FF66;">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Cargando información del producto...</span>
        </div>
    }
    else
    {
        <div class="row bg-dark border border-secondary rounded p-4 g-4 shadow-lg" style="background-color: #1A1D24 !important;">
            <div class="col-md-6">
                <img src="@producto.ImagenUrl" class="img-fluid rounded shadow" alt="@producto.Nombre" style="max-height: 400px; width: 100%; object-fit: cover;">
            </div>
            <div class="col-md-6 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex gap-2 mb-3">
                        @if (producto.SubCategoria?.Categoria != null)
                        {
                            <span class="badge" style="background-color: rgba(0, 255, 102, 0.15); color: #00FF66; border: 1px solid #00FF66; font-size: 0.85rem;">
                                @producto.SubCategoria.Categoria.Nombre
                            </span>
                        }
                        @if (producto.SubCategoria != null)
                        {
                            <span class="badge bg-secondary font-monospace" style="font-size: 0.85rem;">
                                @producto.SubCategoria.Nombre
                            </span>
                        }
                    </div>

                    <h2 class="fw-bold mb-2">@producto.Nombre</h2>
                    <h3 class="fw-bold mb-3" style="color: #00FF66;">$@producto.Precio.ToString("N0")</h3>

                    <hr class="border-secondary">

                    <h5 class="text-light mb-2">Descripción</h5>
                    <p class="text-muted lh-base">@producto.Descripcion</p>

                    @if (!string.IsNullOrEmpty(producto.DetallesTecnicos))
                    {
                        <div class="mt-3 p-3 rounded" style="background-color: #121418; border: 1px solid #2D3748;">
                            <h6 class="text-white fw-bold mb-2"><i class="bi bi-cpu me-2" style="color: #00FF66;"></i>Detalles Técnicos:</h6>
                            <p class="text-light small mb-0" style="white-space: pre-line;">@producto.DetallesTecnicos</p>
                        </div>
                    }

                    <p class="text-muted small mt-4">
                        <i class="bi bi-shield-check text-success me-1"></i> Garantía oficial GamesKorn y soporte técnico especializado.
                    </p>
                </div>

                <div class="mt-4">
                    <button class="btn btn-success w-100 fw-bold py-3 fs-5" @onclick="AgregarAlCarrito">
                        <i class="bi bi-cart-plus-fill me-2"></i> Agregar al carrito
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ProductoModelo? producto;

    protected override async Task OnInitializedAsync()
    {
        producto = await Context.Productos
            .Include(p => p.SubCategoria)
            .ThenInclude(s => s!.Categoria)
            .FirstOrDefaultAsync(p => p.Id == Id);
    }

    private void AgregarAlCarrito()
    {
        if (producto != null)
        {
            CarritoState.AgregarProducto(producto);
        }
    }

    private void VolverAlCatalogo()
    {
        Navigation.NavigateTo("/");
    }
}