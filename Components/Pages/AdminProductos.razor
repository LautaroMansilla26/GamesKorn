@page "/admin/productos"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AppDbContext Context
@inject ToastService ToastService
@using GamesKorn.Components.Models
@using GamesKorn.Data
@using Microsoft.EntityFrameworkCore

<h3 class="fw-bold text-white mb-4">Gestión de Productos</h3>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card bg-dark border-secondary p-4">
            <h5 class="text-white mb-3">@(productoActual.Id == 0 ? "Nuevo Producto" : "Editar Producto")</h5>
            <ProductoForm Producto="productoActual"
                          Categorias="listaCategorias"
                          SubCategoriasDisponibles="listaSubCategorias"
                          OnGuardar="GuardarProductoDb" />
        </div>
    </div>

    <div class="col-md-8">
        <div class="table-responsive">
            <table class="table table-dark table-striped align-middle border-secondary">
                <thead>
                    <tr>
                        <th>Imagen</th>
                        <th>Nombre</th>
                        <th>Categoría / Subcat</th>
                        <th>Precio</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (listaProductos == null)
                    {
                        <tr><td colspan="5" class="text-center">Cargando productos...</td></tr>
                    }
                    else if (!listaProductos.Any())
                    {
                        <tr><td colspan="5" class="text-center">No hay productos registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in listaProductos)
                        {
                            <tr>
                                <td><img src="@p.ImagenUrl" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" /></td>
                                <td>@p.Nombre</td>
                                <td>
                                    <span class="badge bg-secondary">@(p.SubCategoria?.Categoria?.Nombre ?? "S/C")</span>
                                    <br /><small class="text-success">@(p.SubCategoria?.Nombre ?? "Sin subcategoría")</small>
                                </td>
                                <td style="color: #00FF66;">$@p.Precio.ToString("N0")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-warning me-2" @onclick="() => CargarParaEditar(p)">Editar</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarProductoDb(p)">Eliminar</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<ProductoModelo> listaProductos = new();
    private List<SubCategoriaModelo> listaSubCategorias = new();
    private ProductoModelo productoActual = new();
    private List<CategoriaModelo> listaCategorias = new();
    
    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        listaProductos = await Context.Productos
            .Include(p => p.SubCategoria)
            .ThenInclude(s => s!.Categoria)
            .ToListAsync();

        listaCategorias = await Context.Categorias.ToListAsync();
        listaSubCategorias = await Context.SubCategorias.ToListAsync();
    }

    private async Task GuardarProductoDb()
    {
        if (productoActual.Id == 0)
        {
            Context.Productos.Add(productoActual);
            ToastService.Mostrar("Producto creado con éxito en la BD");
        }
        else
        {
            Context.Productos.Update(productoActual);
            ToastService.Mostrar("Producto actualizado con éxito");
        }

        await Context.SaveChangesAsync();
        productoActual = new();
        await CargarDatos();
    }

    private void CargarParaEditar(ProductoModelo prod)
    {
        productoActual = prod;
    }

    private async Task EliminarProductoDb(ProductoModelo prod)
    {
        Context.Productos.Remove(prod);
        await Context.SaveChangesAsync();
        ToastService.Mostrar($"Producto '{prod.Nombre}' eliminado");
        await CargarDatos();
    }
}