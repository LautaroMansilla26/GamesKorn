@page "/Error"
@using System.Diagnostics

<PageTitle>GamesKorn - Error del Sistema</PageTitle>
@* 
COMPONENTE REUTILIZABLE *@

<div class="container py-5 text-white">
    <div class="row justify-content-center">
        <div class="col-md-8 bg-dark border border-danger rounded p-5 shadow-lg" style="background-color: #1A1D24 !important;">

            <!-- Encabezado de Alerta -->
            <div class="text-center mb-4">
                <i class="bi bi-exclamation-triangle-fill text-danger display-1"></i>
                <h1 class="text-danger fw-bold mt-3">¡Ocurrió un error!</h1>
                <h4 class="text-light">Se ha producido un inconveniente al procesar tu solicitud en GamesKorn.</h4>
            </div>

            <!-- Identificador de la solicitud -->
            @if (ShowRequestId)
            {
                <div class="alert alert-secondary bg-black border-secondary text-light text-center" role="alert">
                    <strong>ID de Solicitud:</strong> <code class="text-success">@RequestId</code>
                </div>
            }

            <hr class="border-secondary my-4">

            <!-- Información sobre el entorno -->
            <h5 class="text-white fw-bold"><i class="bi bi-info-circle me-2 text-info"></i>Modo de Desarrollo</h5>
            <p class="text-muted small">
                Cambiar al entorno de <strong>Desarrollo</strong> permite visualizar información más detallada sobre las excepciones ocurridas durante la ejecución.
            </p>
            <p class="text-muted small mb-0">
                <strong class="text-warning">El entorno de desarrollo no debe estar habilitado en aplicaciones desplegadas en producción.</strong>
                Esto puede exponer información sensible de los errores a los usuarios finales. Para depurar localmente, configurá la variable de entorno
                <code>ASPNETCORE_ENVIRONMENT</code> como <code>Development</code> y reiniciá la aplicación.
            </p>

            <!-- Botón de Retorno -->
            <div class="text-center mt-4">
                <a href="/" class="btn btn-success fw-bold px-4 py-2">
                    <i class="bi bi-house-door-fill me-2"></i> Volver al Inicio
                </a>
            </div>

        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}