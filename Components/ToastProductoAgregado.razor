@if (Visible)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div class="toast show bg-dark border border-success text-white shadow-lg rounded-4 p-3" style="background-color: #1A1D24 !important; min-width: 320px;">

            <div class="d-flex align-items-center justify-content-between border-bottom border-secondary pb-2 mb-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-cart-check-fill text-success fs-5"></i>
                    <strong class="text-success small text-uppercase">¡Añadido al Carrito!</strong>
                </div>
                <button type="button" class="btn-close btn-close-white btn-sm shadow-none" @onclick="Cerrar"></button>
            </div>

            <div class="d-flex align-items-center gap-3 my-2">
                @if (!string.IsNullOrEmpty(ImagenUrl))
                {
                    <img src="@ImagenUrl" alt="@NombreProducto" style="width: 60px; height: 50px; object-fit: cover; border-radius: 4px;" />
                }
                <div>
                    <h6 class="mb-1 text-white fw-bold small">@NombreProducto</h6>
                    <span class="text-success fw-bold small">$@Precio.ToString("N0")</span>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <a href="carrito" class="btn btn-success btn-sm w-100 fw-bold">
                    <i class="bi bi-cart3 me-1"></i> Ver Carrito
                </a>
            </div>

        </div>
    </div>
}
@* COMPONENTE REUTILIZABLE - RESUMEN PRODUCTO A AGREGAR *@
@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public string NombreProducto { get; set; } = string.Empty;

    [Parameter]
    public decimal Precio { get; set; }

    [Parameter]
    public string ImagenUrl { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    private async Task Cerrar()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }
}