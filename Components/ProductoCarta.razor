@inject NavigationManager Navigation
@inject ToastService ToastService
@inject CarritoState CarritoState 
@using GamesKorn.Components.Models
@using GamesKorn.Components.Services
@using GamesKorn.Services <!-- Asegúrate de incluir el namespace del carrito -->
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="card h-100 text-white border-secondary card-producto-hover shadow-sm"
     style="background-color: #1A1D24; border-color: #2D3748 !important; cursor: pointer;"
     @onclick="IrADetalle">

    <!-- CONTENEDOR DE IMAGEN -->
    <div class="p-2 d-flex align-items-center justify-content-center" style="height: 140px; background-color: #12151B; border-top-left-radius: 4px; border-top-right-radius: 4px;">
        <img src="@Producto.ImagenUrl" class="img-fluid img-zoom" alt="@Producto.Nombre" style="max-height: 120px; max-width: 100%; object-fit: contain;">
    </div>

    <div class="card-body d-flex flex-column p-3">
        @if (!string.IsNullOrEmpty(Producto.EtiquetaTexto))
        {
            <span class="badge mb-1 px-2 py-1" style="width: fit-content; font-size: 0.7rem; background-color: rgba(0, 255, 102, 0.15); color: #00FF66; border: 1px solid #00FF66;">
                @Producto.EtiquetaTexto
            </span>
        }

        <h6 class="card-title fw-bold text-truncate mb-1" title="@Producto.Nombre">@Producto.Nombre</h6>
        <p class="card-text text-muted small mb-2" style="font-size: 0.8rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            @Producto.Descripcion
        </p>

        <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top border-secondary">
            <span class="fs-5 fw-bold" style="color: #00FF66;">$@Producto.Precio.ToString("N0")</span>
            
            <button class="btn btn-sm btn-primary py-1 px-2 fw-bold" style="font-size: 0.8rem;" @onclick="ComprarClick" @onclick:stopPropagation="true">
                <i class="bi bi-cart-plus me-1"></i> Agregar
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ProductoModelo Producto { get; set; } = default!;

    [Parameter]
    public EventCallback<ProductoModelo> OnComprar { get; set; }

    private async Task ComprarClick()
    {
        // 2. Añadimos el producto al estado compartido del carrito
        CarritoState.AgregarProducto(Producto);

        // 3. Disparamos la notificación flotante
        ToastService.Mostrar($"¡'{Producto.Nombre}' agregado al carrito!");

        if (OnComprar.HasDelegate)
        {
            await OnComprar.InvokeAsync(Producto);
        }
    }

    private void IrADetalle()
    {
        Navigation.NavigateTo($"/producto/{Producto.Id}");
    }
}